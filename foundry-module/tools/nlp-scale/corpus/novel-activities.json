[
  {"id":"nv-001","category":"novel-activities","lang":"en","notes":"Maren spent the afternoon moving the inn's beehives to the south meadow. Only got stung twice and the hives settled in fine.","gold":{"mustTags":[],"okTags":["nature","survival","craft","athletics"],"themesAny":["beekeeping","apiculture","bees","beekeeper","hive-tending"],"outcome":"success","minEvents":1,"maxEvents":1}},
