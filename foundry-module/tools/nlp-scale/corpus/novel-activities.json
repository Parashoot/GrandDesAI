  {"id":"nv-003","category":"novel-activities","lang":"en","notes":"Dunstan brewed his first batch of stout in the cellar. It's cloudy and too sweet but the regulars drank it anyway.","gold":{"mustTags":[],"okTags":["craft","alchemy"],"themesAny":["brewing","brewer","beer-brewing","ale-brewing","brewmaster"],"minEvents":1,"maxEvents":1}},
  {"id":"nv-004","category":"novel-activities","lang":"en","notes":"Second brew came out perfect, crisp amber ale. Dunstan adjusted the malt and kept the fermentation cooler this time.","gold":{"mustTags":[],"okTags":["craft","alchemy","cold","precision"],"themesAny":["brewing","brewer","beer-brewing","ale-brewing","brewmaster"],"outcome":"success|criticalSuccess","minEvents":1,"maxEvents":1}},
  {"id":"nv-005","category":"novel-activities","lang":"en","notes":"Busy night behind the bar. Pell mixed drinks for a full house, remembered everyone's order, and broke up a fight with just a look.","gold":{"mustTags":[],"okTags":["society","intimidation","performance","craft","diplomacy"],"themesAny":["bartending","bartender","mixology","hospitality","barkeep","tavern-keeping"],"outcome":"success","minEvents":1,"maxEvents":2}},
  {"id":"nv-006","category":"novel-activities","lang":"en","notes":"Erin ran the inn solo for the whole festival week: rooms, meals, stabling, all of it. Didn't lose a single guest.","gold":{"mustTags":[],"okTags":["society","craft","leadership","support"],"themesAny":["innkeeping","innkeeper","hospitality","inn-management","tavern-keeping"],"outcome":"success","minEvents":1,"maxEvents":1}},
  {"id":"nv-007","category":"novel-activities","lang":"en","notes":"Cooked for the entire refugee camp, maybe 200 people, with three pots and a borrowed cauldron. Stew and flatbread.","gold":{"mustTags":["craft|support"],"okTags":["craft","support","leadership","survival"],"themesAny":["cooking","mass-cooking","cook","cuisine","chef","catering","feeding"],"outcome":"success","minEvents":1,"maxEvents":1}},
  {"id":"nv-008","category":"novel-activities","lang":"en","notes":"Kip played three-dragon ante all night at the Gilded Lark and walked out 60 gold richer. Pretty sure he was counting cards.","gold":{"mustTags":[],"okTags":["deception","precision","society","thievery","lore"],"themesAny":["gambling","gambler","card-games","cards","card-counting","dice-games","gaming"],"outcome":"success","minEvents":1,"maxEvents":1}},
  {"id":"nv-009","category":"novel-activities","lang":"en","notes":"Grell lost his entire share betting on the dog fights. Again.","gold":{"mustTags":[],"okTags":["society"],"themesAny":["gambling","gambler","betting","wagering"],"outcome":"failure|criticalFailure","minEvents":1,"maxEvents":1}},
