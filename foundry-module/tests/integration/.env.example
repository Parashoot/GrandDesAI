# Copy this file to .env (gitignored) and fill in your own values, or export these as real
# shell/CI environment variables. Never put a real password in a file that gets committed.
#
# Load it yourself before running the live campaign, e.g. in PowerShell:
#   Get-Content tests/integration/.env | ForEach-Object {
#     if ($_ -match '^\s*([^#=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1], $matches[2]) }
#   }
#   npm run test:live-ai
#
# Only set this if your Gamemaster account actually has a password (most Foundry dev worlds do).
FOUNDRY_GM_PASSWORD=

# Everything below is optional -- defaults match a stock local Foundry + Ollama setup.
# FOUNDRY_URL=http://localhost:30000
# FOUNDRY_GM_USER=Gamemaster
# FOUNDRY_AI_PROVIDER=ollama
# FOUNDRY_AI_ENDPOINT=
# FOUNDRY_AI_MODEL=
# FOUNDRY_HEADFUL=1
